---
import PrototypeLayout from '../layouts/PrototypeLayout.astro';
---

<PrototypeLayout
  title="Demo days 0 to 14 reference"
  description="A lightweight interactive reference showing how one product surface evolves from Day 0 to Day 14."
>
  <header class="prototype-header">
    <p class="eyebrow">Prototype / Demo days 0 to 14</p>
    <h1>Demo days 0 to 14 reference</h1>
    <p class="prose muted">
      Use this as a quick visual reference for staged maturity storytelling.
      The interface stays structurally stable while signals and next actions
      evolve across Day 0, 1, 3, 7, 8, and 14.
    </p>
    <div class="button-row">
      <a class="button-link primary" href="https://floramaydc.com/toybox/demo-days-0-to-14-time-machine-playbook/">Read the playbook</a>
      <a class="button-link" href="https://floramaydc.com/toybox/prototypes/demo-days-0-reference/">View live site version</a>
    </div>
  </header>

  <section class="panel" aria-labelledby="day-selector-label">
    <h2 id="day-selector-label">Choose a demo day</h2>
    <p class="muted">Tip: the content below should change meaningfully without changing IA.</p>

    <div class="day-tabs" role="tablist" aria-label="Demo day selector">
      <button type="button" role="tab" aria-selected="true" aria-controls="day-panel" id="day-tab-0" data-day="0" class="day-tab">
        <span class="day-title">Day 0</span>
        <span class="day-subtitle">First run</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-1" data-day="1" class="day-tab">
        <span class="day-title">Day 1</span>
        <span class="day-subtitle">Activated</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-3" data-day="3" class="day-tab">
        <span class="day-title">Day 3</span>
        <span class="day-subtitle">Early pattern</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-7" data-day="7" class="day-tab">
        <span class="day-title">Day 7</span>
        <span class="day-subtitle">Stabilizing</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-8" data-day="8" class="day-tab">
        <span class="day-title">Day 8</span>
        <span class="day-subtitle">After tuning</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-14" data-day="14" class="day-tab">
        <span class="day-title">Day 14</span>
        <span class="day-subtitle">Operational</span>
      </button>
    </div>

    <div class="progress-card">
      <div class="progress-row">
        <p>
          <span class="muted">Selected:</span>
          <span id="current-day-chip" class="day-chip">Day 0 - first run</span>
        </p>
        <p id="day-progress-label" class="muted">Checkpoint progress: 0 of 14 days</p>
      </div>
      <div class="progress-track" aria-hidden="true">
        <div id="day-progress-fill" class="progress-fill" style="width: 0%"></div>
      </div>
    </div>
  </section>

  <section id="day-panel" role="tabpanel" aria-labelledby="day-tab-0" class="state-panel">
    <p class="eyebrow">Current checkpoint</p>
    <h2 id="state-title">Day 0 - first run</h2>
    <p id="state-summary" class="prose muted">No baseline yet. The UI should be explicit about unknowns and setup readiness.</p>

    <div class="metric-grid">
      <article class="metric-card">
        <p class="eyebrow">Coverage</p>
        <p id="metric-coverage" class="metric-value">Unknown</p>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Workflow stability</p>
        <p id="metric-stability" class="metric-value">Not established</p>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Recommended next move</p>
        <p id="metric-next" class="metric-value">Start guided setup</p>
      </article>
    </div>

    <div class="narrative-card">
      <p class="eyebrow">Narrative check</p>
      <p id="narrative-check">Day 0 should feel honest, not incomplete. Unknown states are valid product states.</p>
    </div>
  </section>

  <footer class="prototype-footer">
    <p><a href="https://floramaydc.com/toybox/demo-days-0-to-14-time-machine-playbook/">Back to the Demo Days playbook</a></p>
  </footer>

  <script is:inline>
    const stateByDay = {
      0: {
        title: 'Day 0 - first run',
        summary: 'No baseline yet. The UI should be explicit about unknowns and setup readiness.',
        coverage: 'Unknown',
        stability: 'Not established',
        next: 'Start guided setup',
        check: 'Day 0 should feel honest, not incomplete. Unknown states are valid product states.'
      },
      1: {
        title: 'Day 1 - activated',
        summary: 'Initial setup is complete and first meaningful signals are now visible.',
        coverage: 'Early baseline captured',
        stability: 'Low but measurable',
        next: 'Complete first guided action',
        check: 'The user should feel momentum without pretending the system is mature.'
      },
      3: {
        title: 'Day 3 - early pattern',
        summary: 'Repeated activity appears, enough to prioritize the first optimization target.',
        coverage: 'Growing',
        stability: 'Emerging pattern',
        next: 'Prioritize highest-friction step',
        check: 'This is where trend direction matters more than absolute values.'
      },
      7: {
        title: 'Day 7 - stabilizing',
        summary: 'The flow is becoming predictable and recommendations can be more selective.',
        coverage: 'Broad',
        stability: 'Moderate and improving',
        next: 'Run targeted intervention',
        check: 'The UI should reduce noise and show clearer decision support.'
      },
      8: {
        title: 'Day 8 - after tuning',
        summary: 'One optimization pass has landed and changes are visible in operational signals.',
        coverage: 'Broad + tuned',
        stability: 'Shift after adjustment',
        next: 'Validate post-change impact',
        check: 'Day 8 exists to show causality after change, not just another snapshot.'
      },
      14: {
        title: 'Day 14 - operational',
        summary: 'The experience reflects short-term maturity with routine maintenance behavior.',
        coverage: 'Operational baseline',
        stability: 'Steady-state',
        next: 'Maintain and refine',
        check: 'This state should communicate confidence without implying finality.'
      }
    };

    const tabs = Array.from(document.querySelectorAll('.day-tab'));
    const titleEl = document.getElementById('state-title');
    const summaryEl = document.getElementById('state-summary');
    const coverageEl = document.getElementById('metric-coverage');
    const stabilityEl = document.getElementById('metric-stability');
    const nextEl = document.getElementById('metric-next');
    const checkEl = document.getElementById('narrative-check');
    const panelEl = document.getElementById('day-panel');
    const dayChipEl = document.getElementById('current-day-chip');
    const progressLabelEl = document.getElementById('day-progress-label');
    const progressFillEl = document.getElementById('day-progress-fill');

    function applyDay(day) {
      const state = stateByDay[day];
      if (!state) return;
      titleEl.textContent = state.title;
      summaryEl.textContent = state.summary;
      coverageEl.textContent = state.coverage;
      stabilityEl.textContent = state.stability;
      nextEl.textContent = state.next;
      checkEl.textContent = state.check;
      dayChipEl.textContent = state.title;
      progressLabelEl.textContent = `Checkpoint progress: ${day} of 14 days`;
      progressFillEl.style.width = `${(day / 14) * 100}%`;

      tabs.forEach((button) => {
        const active = button.dataset.day === String(day);
        button.setAttribute('aria-selected', active ? 'true' : 'false');
        button.classList.toggle('day-tab-active', active);
        const subtitle = button.querySelector('.day-subtitle');
        if (subtitle) subtitle.classList.toggle('day-subtitle-active', active);
        if (active) panelEl.setAttribute('aria-labelledby', button.id);
      });
    }

    function focusAndApply(index) {
      const target = tabs[index];
      if (!target) return;
      target.focus();
      applyDay(Number(target.dataset.day));
    }

    tabs.forEach((button) => {
      button.addEventListener('click', () => applyDay(Number(button.dataset.day)));
      button.addEventListener('keydown', (event) => {
        const index = tabs.indexOf(button);
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          focusAndApply((index + 1) % tabs.length);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          focusAndApply((index - 1 + tabs.length) % tabs.length);
        } else if (event.key === 'Home') {
          event.preventDefault();
          focusAndApply(0);
        } else if (event.key === 'End') {
          event.preventDefault();
          focusAndApply(tabs.length - 1);
        }
      });
    });

    applyDay(0);
  </script>

  <style>
    .day-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .day-tab {
      min-width: 8.25rem;
      border: 1px solid rgb(var(--c-ink) / 0.2);
      border-radius: 6px;
      background: rgb(var(--c-paper));
      color: rgb(var(--c-ink));
      padding: 0.65rem 0.8rem;
      text-align: left;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .day-tab:hover {
      border-color: rgb(var(--c-accent) / 0.5);
      background-color: rgb(var(--c-accent) / 0.06);
    }

    .day-tab:focus-visible {
      outline: 2px solid rgb(var(--c-accent));
      outline-offset: 2px;
    }

    .day-title,
    .day-subtitle {
      display: block;
    }

    .day-title {
      font-weight: 700;
    }

    .day-subtitle {
      color: rgb(var(--c-muted));
      font-size: 0.78rem;
    }

    .day-tab-active {
      border-color: rgb(var(--c-accent));
      background-color: rgb(var(--c-accent));
      color: rgb(var(--c-paper));
      box-shadow: 0 0 0 1px rgb(var(--c-accent));
    }

    .day-subtitle-active {
      color: rgb(var(--c-paper) / 0.92);
    }

    .progress-card,
    .state-panel {
      border: 1px solid rgb(var(--c-ink) / 0.12);
      border-radius: 8px;
      background: rgb(var(--c-cream) / 0.55);
      margin-top: 1rem;
      padding: 1rem;
    }

    .progress-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .day-chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgb(var(--c-accent) / 0.5);
      border-radius: 999px;
      color: rgb(var(--c-accent));
      font-size: 0.78rem;
      font-weight: 700;
      margin-left: 0.5rem;
      padding: 0.2rem 0.55rem;
    }

    .progress-track {
      height: 0.5rem;
      border-radius: 999px;
      background: rgb(var(--c-ink) / 0.1);
    }

    .progress-fill {
      height: 100%;
      border-radius: inherit;
      background: rgb(var(--c-accent));
      transition: width 0.2s ease;
    }

    .state-panel {
      background: rgb(var(--c-paper));
      margin-top: 2rem;
      padding: 1.5rem;
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .metric-card,
    .narrative-card {
      border: 1px solid rgb(var(--c-ink) / 0.12);
      border-radius: 8px;
      padding: 1rem;
    }

    .metric-value {
      font-size: 1.25rem;
      line-height: 1.25;
    }

    .narrative-card {
      border-color: rgb(var(--c-accent) / 0.35);
      background: rgb(var(--c-accent) / 0.06);
      margin-top: 1.5rem;
    }
  </style>
</PrototypeLayout>
