---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Public Toybox prototype references from floramaydc.com.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrapper">
      <nav class="site-nav" aria-label="Prototype navigation">
        <a class="brand" href="/">Toybox Prototypes</a>
        <div class="nav-links">
          <a href="/fluent-theme-toggle/">Fluent theme toggle</a>
          <a href="/demo-days-0-reference/">Demo days 0 to 14</a>
          <a href="https://floramaydc.com/toybox/prototypes/">Live on floramaydc.com</a>
        </div>
      </nav>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
