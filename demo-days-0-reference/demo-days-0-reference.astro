---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout
  title="Demo Days 0-14 prototype — Flora May dela Cruz"
  description="A lightweight interactive reference showing how one product surface evolves from Day 0 to Day 14."
>
  <header class="border-b border-ink/10 pb-8">
    <p class="text-sm uppercase tracking-widest text-muted">
      <a href={`${base}toybox`} class="hover:text-accent">Toybox</a>
      {' / '}
      <a href={`${base}toybox/demo-days-0-to-14-time-machine-playbook`} class="hover:text-accent">Demo days 0-14 playbook</a>
      {' / '}
      <span>Live reference</span>
    </p>
    <h1 class="mt-3 text-4xl">Demo days 0 to 14 - live reference</h1>
    <p class="mt-4 max-w-prose text-muted">
      Use this as a quick visual reference for staged maturity storytelling.
      The interface stays structurally stable while signals and next actions
      evolve across Day 0, 1, 3, 7, 8, and 14.
    </p>
  </header>

  <section class="mt-8" aria-labelledby="day-selector-label">
    <h2 id="day-selector-label" class="text-lg">Choose a demo day</h2>
    <p class="mt-2 text-sm text-muted">Tip: the content below should change meaningfully without changing IA.</p>

    <div class="mt-4 flex flex-wrap gap-2" role="tablist" aria-label="Demo day selector">
      <button type="button" role="tab" aria-selected="true" aria-controls="day-panel" id="day-tab-0" data-day="0" class="day-tab rounded-md border border-ink/20 px-3 py-2 text-sm">
        <span class="block font-semibold">Day 0</span>
        <span class="day-subtitle block text-xs text-muted">First run</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-1" data-day="1" class="day-tab rounded-md border border-ink/20 px-3 py-2 text-sm">
        <span class="block font-semibold">Day 1</span>
        <span class="day-subtitle block text-xs text-muted">Activated</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-3" data-day="3" class="day-tab rounded-md border border-ink/20 px-3 py-2 text-sm">
        <span class="block font-semibold">Day 3</span>
        <span class="day-subtitle block text-xs text-muted">Early pattern</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-7" data-day="7" class="day-tab rounded-md border border-ink/20 px-3 py-2 text-sm">
        <span class="block font-semibold">Day 7</span>
        <span class="day-subtitle block text-xs text-muted">Stabilizing</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-8" data-day="8" class="day-tab rounded-md border border-ink/20 px-3 py-2 text-sm">
        <span class="block font-semibold">Day 8</span>
        <span class="day-subtitle block text-xs text-muted">After tuning</span>
      </button>
      <button type="button" role="tab" aria-selected="false" aria-controls="day-panel" id="day-tab-14" data-day="14" class="day-tab rounded-md border border-ink/20 px-3 py-2 text-sm">
        <span class="block font-semibold">Day 14</span>
        <span class="day-subtitle block text-xs text-muted">Operational</span>
      </button>
    </div>

    <div class="mt-4 rounded-md border border-ink/10 bg-cream/50 p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm">
          <span class="text-muted">Selected:</span>
          <span id="current-day-chip" class="ml-2 inline-flex items-center rounded-full border border-accent/50 bg-accent/[0.10] px-2.5 py-0.5 text-xs font-semibold text-accent">Day 0 - first run</span>
        </p>
        <p id="day-progress-label" class="text-xs text-muted">Checkpoint progress: 0 of 14 days</p>
      </div>
      <div class="mt-3 h-2 rounded-full bg-ink/10">
        <div id="day-progress-fill" class="h-full rounded-full bg-accent transition-[width] duration-200" style="width: 0%"></div>
      </div>
    </div>
  </section>

  <section id="day-panel" role="tabpanel" aria-labelledby="day-tab-0" class="mt-8 rounded-lg border border-ink/10 bg-paper p-6">
    <p class="text-[10px] uppercase tracking-widest text-muted">Current checkpoint</p>
    <h2 id="state-title" class="mt-2 text-2xl">Day 0 - first run</h2>
    <p id="state-summary" class="mt-3 max-w-prose text-muted">No baseline yet. The UI should be explicit about unknowns and setup readiness.</p>

    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <article class="rounded-md border border-ink/10 p-4">
        <p class="text-[10px] uppercase tracking-widest text-muted">Coverage</p>
        <p id="metric-coverage" class="mt-2 text-xl">Unknown</p>
      </article>
      <article class="rounded-md border border-ink/10 p-4">
        <p class="text-[10px] uppercase tracking-widest text-muted">Workflow stability</p>
        <p id="metric-stability" class="mt-2 text-xl">Not established</p>
      </article>
      <article class="rounded-md border border-ink/10 p-4">
        <p class="text-[10px] uppercase tracking-widest text-muted">Recommended next move</p>
        <p id="metric-next" class="mt-2 text-xl">Start guided setup</p>
      </article>
    </div>

    <div class="mt-6 rounded-md border border-accent/30 bg-accent/[0.06] p-4">
      <p class="text-[10px] uppercase tracking-widest text-accent">Narrative check</p>
      <p id="narrative-check" class="mt-2 text-sm">Day 0 should feel honest, not incomplete. Unknown states are valid product states.</p>
    </div>
  </section>

  <section class="mt-8 rounded-lg border border-ink/10 bg-cream/40 p-6">
    <h2 class="text-xl">Source and install</h2>
    <p class="mt-2 max-w-prose text-sm text-muted">
      This reference builds on the same public baseline as the Fluent theme
      toggle prototype. Use the public repo to install and adapt.
    </p>
    <p class="mt-4">
      <a
        class="underline"
        href="https://github.com/floramaydc/toybox-prototypes"
        target="_blank"
        rel="noopener noreferrer"
      >
        github.com/floramaydc/toybox-prototypes
      </a>
    </p>
    <pre class="mt-4 overflow-x-auto rounded-md border border-ink/10 bg-paper p-4 text-xs"><code>git clone https://github.com/floramaydc/toybox-prototypes.git
cd toybox-prototypes
npm install
npm run dev</code></pre>
    <p class="mt-3 text-sm text-muted">
      Baseline reference:
      <a class="underline" href={`${base}toybox/prototypes/fluent-theme-toggle`}>Fluent theme toggle live demo</a>
    </p>
  </section>

  <footer class="mt-12 border-t border-ink/10 pt-6 text-sm text-muted">
    <p>
      <a class="underline" href={`${base}toybox/demo-days-0-to-14-time-machine-playbook`}>Back to the playbook</a>
    </p>
  </footer>

  <script is:inline>
    const stateByDay = {
      0: {
        title: 'Day 0 - first run',
        summary: 'No baseline yet. The UI should be explicit about unknowns and setup readiness.',
        coverage: 'Unknown',
        stability: 'Not established',
        next: 'Start guided setup',
        check: 'Day 0 should feel honest, not incomplete. Unknown states are valid product states.'
      },
      1: {
        title: 'Day 1 - activated',
        summary: 'Initial setup is complete and first meaningful signals are now visible.',
        coverage: 'Early baseline captured',
        stability: 'Low but measurable',
        next: 'Complete first guided action',
        check: 'The user should feel momentum without pretending the system is mature.'
      },
      3: {
        title: 'Day 3 - early pattern',
        summary: 'Repeated activity appears, enough to prioritize the first optimization target.',
        coverage: 'Growing',
        stability: 'Emerging pattern',
        next: 'Prioritize highest-friction step',
        check: 'This is where trend direction matters more than absolute values.'
      },
      7: {
        title: 'Day 7 - stabilizing',
        summary: 'The flow is becoming predictable and recommendations can be more selective.',
        coverage: 'Broad',
        stability: 'Moderate and improving',
        next: 'Run targeted intervention',
        check: 'The UI should reduce noise and show clearer decision support.'
      },
      8: {
        title: 'Day 8 - after tuning',
        summary: 'One optimization pass has landed and changes are visible in operational signals.',
        coverage: 'Broad + tuned',
        stability: 'Shift after adjustment',
        next: 'Validate post-change impact',
        check: 'Day 8 exists to show causality after change, not just another snapshot.'
      },
      14: {
        title: 'Day 14 - operational',
        summary: 'The experience reflects short-term maturity with routine maintenance behavior.',
        coverage: 'Operational baseline',
        stability: 'Steady-state',
        next: 'Maintain and refine',
        check: 'This state should communicate confidence without implying finality.'
      }
    };

    const tabs = Array.from(document.querySelectorAll('.day-tab'));
    const titleEl = document.getElementById('state-title');
    const summaryEl = document.getElementById('state-summary');
    const coverageEl = document.getElementById('metric-coverage');
    const stabilityEl = document.getElementById('metric-stability');
    const nextEl = document.getElementById('metric-next');
    const checkEl = document.getElementById('narrative-check');
    const panelEl = document.getElementById('day-panel');
    const dayChipEl = document.getElementById('current-day-chip');
    const progressLabelEl = document.getElementById('day-progress-label');
    const progressFillEl = document.getElementById('day-progress-fill');

    function applyDay(day) {
      const s = stateByDay[day];
      if (!s) return;
      titleEl.textContent = s.title;
      summaryEl.textContent = s.summary;
      coverageEl.textContent = s.coverage;
      stabilityEl.textContent = s.stability;
      nextEl.textContent = s.next;
      checkEl.textContent = s.check;
      dayChipEl.textContent = s.title;
      progressLabelEl.textContent = `Checkpoint progress: ${day} of 14 days`;
      progressFillEl.style.width = `${(day / 14) * 100}%`;

      tabs.forEach((btn) => {
        const active = btn.dataset.day === String(day);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.classList.toggle('day-tab-active', active);
        const subtitle = btn.querySelector('.day-subtitle');
        if (subtitle) subtitle.classList.toggle('day-subtitle-active', active);
        if (active) {
          panelEl.setAttribute('aria-labelledby', btn.id);
        }
      });
    }

    function focusAndApply(index) {
      const target = tabs[index];
      if (!target) return;
      target.focus();
      applyDay(Number(target.dataset.day));
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => applyDay(Number(btn.dataset.day)));
      btn.addEventListener('keydown', (evt) => {
        const i = tabs.indexOf(btn);
        if (evt.key === 'ArrowRight') {
          evt.preventDefault();
          focusAndApply((i + 1) % tabs.length);
        } else if (evt.key === 'ArrowLeft') {
          evt.preventDefault();
          focusAndApply((i - 1 + tabs.length) % tabs.length);
        } else if (evt.key === 'Home') {
          evt.preventDefault();
          focusAndApply(0);
        } else if (evt.key === 'End') {
          evt.preventDefault();
          focusAndApply(tabs.length - 1);
        }
      });
    });

    applyDay(0);
  </script>

  <style>
    .day-tab {
      min-width: 8.25rem;
      text-align: left;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .day-tab:hover {
      border-color: rgb(var(--c-accent) / 0.5);
      background-color: rgb(var(--c-accent) / 0.06);
    }
    .day-tab:focus-visible {
      outline: 2px solid rgb(var(--c-accent));
      outline-offset: 2px;
    }
    .day-tab-active {
      border-color: rgb(var(--c-accent));
      background-color: rgb(var(--c-accent));
      color: rgb(var(--c-paper));
      box-shadow: 0 0 0 1px rgb(var(--c-accent));
    }
    .day-subtitle-active {
      color: rgb(var(--c-paper) / 0.92) !important;
    }
  </style>
</BaseLayout>
